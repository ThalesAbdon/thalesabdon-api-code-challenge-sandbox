{
  "name": "api-code-challenge",
  "version": "1.0.0",
  "description": "A project to evaluate potential candidates for the API team",
  "scripts": {
    "setup": "./scripts/setup.sh",
    "start:mock-ai": "ts-node services/mock-ai-server/src/index.ts",
    "start:nest": "docker-compose up nestjs",
    "test:e2e": "npx jest",
    "deploy:lambda": "cd services/lambdas && npx serverless offline start --host 0.0.0.0 --httpPort 4000",
    "install:all": "npm install && cd services/lambdas && npm install && cd ../nestjs && npm install && cd ../mock-ai-server && npm install",
    "prisma:migrate": "npx prisma migrate dev --name init",
    "format": "prettier --write \"**/*.{js,ts,json,md}\"",
    "overview:diagrams:generate": "npx @mermaid-js/mermaid-cli -i docs/OVERVIEW.md -o docs/OVERVIEW.png"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.4.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.7",
    "jest": "^30.2.0",
    "prettier": "^3.5.3",
    "prisma": "^6.5.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "axios": "^1.13.2"
  }
}
